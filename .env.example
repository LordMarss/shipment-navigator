# Environment variables for the AIS pipeline: the standalone ingestion
# worker (scripts/ais-listener.ts / `npm run ais:listen`) and the AIS
# automation webhook endpoint it eventually notifies
# (src/routes/api/public/hooks/ais-position.ts, deployed as part of the
# main Vercel app). This is not a full list of every variable the main app
# uses — just what these two pieces read.
#
# Copy to `.env` (already gitignored) and fill in real values. Never commit
# real values, and never expose AISSTREAM_API_KEY, the service-role key, or
# AIS_WEBHOOK_SECRET to client-side code.

# --- Required ---------------------------------------------------------

# Supabase project URL (same project the main app uses).
SUPABASE_URL=

# Supabase service-role key. Bypasses RLS — server-side only, never ship
# this to a browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# AISStream.io API key. https://aisstream.io — server-side only.
AISSTREAM_API_KEY=

# --- Optional (sensible defaults apply if unset) -----------------------

# How often the worker re-reads the shipments table for MMSI changes, in ms.
# Default: 300000 (5 minutes).
AIS_RESYNC_INTERVAL_MS=

# Base delay before the first reconnect attempt after an unexpected
# disconnect, in ms. Backs off exponentially (capped) on repeated failures.
# Default: 5000 (5 seconds).
AIS_RECONNECT_DELAY_MS=

# How long to wait for a WebSocket connection to open before giving up and
# retrying, in ms. Default: 10000 (10 seconds).
AIS_CONNECT_TIMEOUT_MS=

# --- AIS automation webhook endpoint (Vercel deployment) ----------------

# Shared secret the Supabase Database Webhook on vessel_positions
# (see the Phase 4B migration) must present in an X-AIS-Webhook-Secret
# header when calling /api/public/hooks/ais-position. Required for that
# endpoint to accept a request — server-side only, never AISSTREAM_API_KEY,
# never CRON_SECRET.
AIS_WEBHOOK_SECRET=
